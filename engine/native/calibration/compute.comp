#version 450
layout(local_size_x=128) in;
layout(set=0,binding=0,std430) readonly buffer Input {float src[];};
layout(set=0,binding=1,std430) writeonly buffer Output {float dst[];};
layout(push_constant) uniform Config {uint iterations;} config;
void main(){
 uint i=gl_GlobalInvocationID.x*8;
 vec4 a=vec4(src[i],src[i+1],src[i+2],src[i+3]);
 vec4 b=vec4(src[i+4],src[i+5],src[i+6],src[i+7]);
 for(uint n=0;n<config.iterations;n++){a=fma(a,vec4(.9999),vec4(.0001));b=fma(b,vec4(.9999),vec4(.0001));}
 dst[i]=a.x;dst[i+1]=a.y;dst[i+2]=a.z;dst[i+3]=a.w;
 dst[i+4]=b.x;dst[i+5]=b.y;dst[i+6]=b.z;dst[i+7]=b.w;
}
