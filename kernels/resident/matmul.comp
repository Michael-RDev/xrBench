#version 450
// Persistent FP32 buffers. TILE_ROWS is 1 for the baseline, 2 for the candidate.
#ifndef TILE_ROWS
#define TILE_ROWS 1
#endif
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer A { float a[]; };
layout(set=0,binding=1,std430) readonly buffer B { float b[]; };
layout(set=0,binding=2,std430) writeonly buffer C { float c[]; };
layout(push_constant) uniform Shape { uint m; uint k; uint n; uint incorrect; } shape;
void main() {
    uint index=gl_GlobalInvocationID.x;
    uint row=(index/shape.n)*TILE_ROWS, col=index%shape.n;
    if(row>=shape.m)return;
    float acc[TILE_ROWS];
    for(uint t=0;t<TILE_ROWS;t++)acc[t]=0.0;
    for(uint j=0;j<shape.k;j++){
        float v=b[j*shape.n+col];
        for(uint t=0;t<TILE_ROWS;t++)if(row+t<shape.m)
            acc[t]=fma(a[(row+t)*shape.k+j],v,acc[t]);
    }
    for(uint t=0;t<TILE_ROWS;t++)if(row+t<shape.m)
        c[(row+t)*shape.n+col]=acc[t]+(shape.incorrect!=0?1000.0:0.0);
}
