# Public build target. Copy to .env.hosting (ignored). Completed results upload
# automatically through the same-origin proxy; JSON downloads stay available.
# Visitors do not enter contact details or sign in.
XRBENCH_DEPLOYMENT=hosted
XRBENCH_SUPABASE_URL=https://nqsieptekarxxmqrgmdy.supabase.co
XRBENCH_REPORT_DELIVERY=automatic
XRBENCH_REPORT_ENDPOINT=/api/reports
# Set the actual intended website origin; omit a path here.
XRBENCH_SITE_ORIGIN=https://xrbench.mickirusu.chatgpt.site
XRBENCH_SITE_PATH=/
# Backend credentials belong only to the separately protected receiver.
